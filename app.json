{
  "expo": {
    "name": "CommUnity",
    "slug": "CommUnity",
    "version": "1.0.0",
    "scheme": "CommUnity",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpg",
        "backgroundColor": "#000000"
      },
      "package": "com.shwetishere.CommUnity"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a0f33c8-ce6b-4828-af95-b00fa885296c"
      }
    }
  }
}
